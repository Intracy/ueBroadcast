# ueBroadcast – lokale Einstellungen. Kopieren nach .env und anpassen.

# Port der Regie-Oberfläche (http://localhost:4400)
UEB_PORT=4400

# Welche Produktion beim Start aktiv ist (Dateiname ohne .json in /productions)
UEB_PRODUCTION=sm64-marathon

# OBS-WebSocket (OBS → Werkzeuge → WebSocket-Servereinstellungen).
# Leer lassen = Simulationsmodus ohne OBS.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Adresse, unter der OBS die Overlay-Seite erreicht (Browserquelle)
UEB_PUBLIC_URL=http://localhost:4400

# Optionaler Schutz für das Split-Relay der Runner (Header x-ueb-token)
UEB_RELAY_TOKEN=

# Twitch (optional) – für Stream-Marker und Titel
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
